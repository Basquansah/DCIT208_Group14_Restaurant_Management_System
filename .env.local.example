# Supabase project URL and public anon key (safe for browser use).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: used only by server-side API routes. Never prefix with NEXT_PUBLIC_
# or expose this key in client-side code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional dedicated signing key. When unset, the server-only service role
# key is used to sign and verify sessions.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
